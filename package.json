{
	"name": "ssr-boilerplate",
	"version": "2.1.1",
	"repository": "https://github.com/denchiklut/ssr-boilerplate.git",
	"license": "MIT",
	"description": "ssr boilerplate",
	"author": "Karl: ollylut@gmail.com",
	"scripts": {
		"dev": "run-p dev:*",
		"predev": "rspack build --configName express",
		"dev:build": "rspack --nodeEnv development --configName express --watch",
		"dev:serve": "cross-env NODE_ENV=development nodemon --inspect dist/express",
		"spa": "rspack serve --nodeEnv development -c rspack/configs/spa.config.ts"
	},
	"dependencies": {
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"react": "^19.1.1",
		"react-cookie": "^8.0.1",
		"react-dom": "^19.1.1",
		"react-error-boundary": "^6.0.0",
		"react-router": "^7.8.2",
		"reflect-metadata": "^0.2.2",
		"universal-cookie": "^8.0.1",
		"winston": "^3.17.0",
		"zod": "^4.1.1"
	},
	"devDependencies": {
		"@rspack/cli": "^1.4.11",
		"@rspack/core": "^1.4.11",
		"@rspack/plugin-react-refresh": "^1.4.3",
		"@swc/register": "^0.1.10",
		"@types/express": "^5.0.3",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"cross-env": "^10.0.0",
		"esbuild": "^0.25.9",
		"nodemon": "^3.1.10",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.2"
	}
}
