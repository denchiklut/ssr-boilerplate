{
	"name": "ssr-boilerplate",
	"version": "2.1.1",
	"repository": "https://github.com/denchiklut/ssr-boilerplate.git",
	"license": "MIT",
	"description": "ssr boilerplate",
	"author": "Karl: ollylut@gmail.com",
	"scripts": {
		"dev": "run-p dev:*",
		"predev": "rspack build --nodeEnv=development --configName=express",
		"dev:build": "rspack --nodeEnv=development --configName=express --watch",
		"dev:serve": "cross-env NODE_ENV=development nodemon --inspect dist/server",
		"start": "run-s prod:*",
		"prod:build": "rimraf dist && rspack --nodeEnv=production",
		"prod:start": "cross-env NODE_ENV=production node dist/server",
		"spa": "rspack serve --nodeEnv=development -c=rspack/configs/spa.config.ts",
		"test": "jest --coverage --coverage-reporters=lcov",
		"biome": "biome check --write ."
	},
	"dependencies": {
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"morgan": "^1.10.1",
		"react": "^19.1.1",
		"react-cookie": "^8.0.1",
		"react-dom": "^19.1.1",
		"react-error-boundary": "^6.0.0",
		"react-router": "^7.8.2",
		"reflect-metadata": "^0.2.2",
		"serve-favicon": "^2.5.1",
		"tiny-invariant": "^1.3.3",
		"universal-cookie": "^8.0.1",
		"universal-cookie-express": "^8.0.1",
		"uuid": "^11.1.0",
		"winston": "^3.17.0",
		"zod": "^4.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@rspack/cli": "^1.5.0-rc.0",
		"@rspack/core": "^1.5.0-rc.0",
		"@rspack/plugin-react-refresh": "^1.4.3",
		"@swc/jest": "^0.2.39",
		"@swc/register": "^0.1.10",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/express": "^5.0.3",
		"@types/jest": "^30.0.0",
		"@types/morgan": "^1.9.10",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"@types/require-from-string": "^1.2.3",
		"@types/serve-favicon": "^2.5.7",
		"@types/webpack-node-externals": "^3.0.4",
		"cross-env": "^10.0.0",
		"esbuild": "^0.25.9",
		"jest": "^30.0.5",
		"jest-environment-jsdom": "^30.0.5",
		"nodemon": "^3.1.10",
		"npm-run-all": "^4.1.5",
		"require-from-string": "^2.0.2",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.2",
		"webpack-dev-middleware": "^7.4.2",
		"webpack-hot-middleware": "^2.26.1",
		"webpack-node-externals": "^3.0.0"
	}
}
