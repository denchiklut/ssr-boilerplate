{
	"name": "ssr-boilerplate",
	"version": "3.0.0",
	"repository": "https://github.com/denchiklut/ssr-boilerplate.git",
	"license": "MIT",
	"description": "ssr boilerplate",
	"author": "Karl: ollylut@gmail.com",
	"packageManager": "pnpm@10.27.0",
	"scripts": {
		"dev": "run-p dev:*",
		"predev": "rspack build --nodeEnv=development --configName=express",
		"dev:build": "rspack --nodeEnv=development --configName=express --watch",
		"dev:serve": "cross-env NODE_ENV=development nodemon --inspect dist/server",
		"start": "run-s prod:*",
		"prod:build": "rimraf dist && rspack --nodeEnv=production",
		"prod:start": "cross-env NODE_ENV=production node dist/server",
		"spa": "rspack serve --nodeEnv=development -c=rspack/configs/spa.config.ts",
		"ts-check": "tsgo -p tsconfig.json --noEmit",
		"test": "jest --coverage --coverage-reporters=lcov",
		"lint:style": "stylelint --fix src/**/*.{css,scss}",
		"lint:script": "biome check --write --unsafe .",
		"lint": "run-p lint:*",
		"setup": "sh setup.sh"
	},
	"dependencies": {
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"morgan": "^1.10.1",
		"react": "^19.2.3",
		"react-cookie": "^8.0.1",
		"react-dom": "^19.2.3",
		"react-error-boundary": "^6.0.1",
		"react-router": "^7.11.0",
		"serve-favicon": "^2.5.1",
		"tiny-invariant": "^1.3.3",
		"universal-cookie": "^8.0.1",
		"universal-cookie-express": "^8.0.1",
		"url-join": "4.0.1",
		"uuid": "^13.0.0",
		"winston": "^3.19.0",
		"workbox-window": "^7.4.0",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@aaroon/workbox-rspack-plugin": "^0.3.2",
		"@biomejs/biome": "2.3.11",
		"@rspack/cli": "^1.7.0",
		"@rspack/core": "^1.7.0",
		"@rspack/plugin-react-refresh": "^1.5.3",
		"@svgr/webpack": "^8.1.0",
		"@swc/jest": "^0.2.39",
		"@swc/register": "^0.1.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/morgan": "^1.9.10",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/require-from-string": "^1.2.3",
		"@types/serve-favicon": "^2.5.7",
		"@types/url-join": "4.0.3",
		"@types/webpack-env": "^1.18.8",
		"@types/webpack-node-externals": "^3.0.4",
		"@typescript/native-preview": "7.0.0-dev.20260104.1",
		"autoprefixer": "^10.4.23",
		"cross-env": "^10.1.0",
		"css-loader": "^7.1.2",
		"cssnano": "^7.1.2",
		"esbuild": "^0.27.2",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"lint-staged": "^16.2.7",
		"nodemon": "^3.1.11",
		"npm-run-all": "^4.1.5",
		"postcss-loader": "^8.2.0",
		"require-from-string": "^2.0.2",
		"rimraf": "^6.1.2",
		"sass": "^1.97.1",
		"sass-loader": "^16.0.6",
		"stylelint": "^16.26.1",
		"stylelint-config-standard": "^39.0.1",
		"stylelint-scss": "^6.14.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"webpack-dev-middleware": "^7.4.5",
		"webpack-hot-middleware": "^2.26.1",
		"webpack-node-externals": "^3.0.0",
		"workbox-precaching": "^7.4.0",
		"workbox-recipes": "^7.4.0",
		"workbox-routing": "^7.4.0",
		"workbox-strategies": "^7.4.0"
	}
}
