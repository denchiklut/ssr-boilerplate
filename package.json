{
	"name": "ssr-boilerplate",
	"version": "3.0.0",
	"repository": "https://github.com/denchiklut/ssr-boilerplate.git",
	"license": "MIT",
	"description": "ssr boilerplate",
	"author": "Karl: ollylut@gmail.com",
	"scripts": {
		"dev": "run-p dev:*",
		"predev": "rspack build --config-loader jiti --nodeEnv=development --configName=express",
		"dev:build": "rspack --config-loader jiti --nodeEnv=development --configName=express --watch",
		"dev:serve": "cross-env NODE_ENV=development nodemon --inspect dist/server",
		"start": "run-s prod:*",
		"prod:build": "rimraf dist && rspack --config-loader jiti --nodeEnv=production",
		"prod:start": "cross-env NODE_ENV=production node --enable-source-maps dist/server",
		"ts-check": "tsc -p tsconfig.json --noEmit",
		"test": "jest --coverage --coverage-reporters=lcov",
		"lint:style": "stylelint --fix src/**/*.{css,scss}",
		"lint:script": "biome check --write --unsafe .",
		"lint": "run-p lint:*",
		"repro": "node scripts/repro-form-action.mjs",
		"setup": "sh setup.sh"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"morgan": "^1.11.0",
		"react": "^19.2.7",
		"react-cookie": "^8.1.2",
		"react-dom": "^19.2.7",
		"react-error-boundary": "^6.1.2",
		"react-router": "^8.2.0",
		"react-server-dom-rspack": "0.0.2",
		"serve-favicon": "^2.5.1",
		"server-only": "^0.0.1",
		"tiny-invariant": "^1.3.3",
		"triple-beam": "^1.4.1",
		"universal-cookie": "^8.1.2",
		"universal-cookie-express": "^8.1.2",
		"url-join": "5.0.0",
		"uuid": "^14.0.1",
		"winston": "^3.19.0",
		"workbox-window": "^7.4.1",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@aaroon/workbox-rspack-plugin": "^1.0.1",
		"@biomejs/biome": "2.5.3",
		"@rspack/cli": "^2.1.5",
		"@rspack/core": "^2.1.5",
		"@rspack/dev-middleware": "^2.0.3",
		"@rspack/plugin-react-refresh": "^2.0.2",
		"@svgr/webpack": "^8.1.0",
		"@swc/jest": "^0.2.39",
		"@swc/register": "^0.1.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/morgan": "^1.9.10",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/require-from-string": "^1.2.3",
		"@types/serve-favicon": "^2.5.7",
		"@types/triple-beam": "^1.3.5",
		"@types/url-join": "5.0.0",
		"@types/webpack-env": "^1.18.8",
		"@types/webpack-node-externals": "^3.0.4",
		"autoprefixer": "^10.5.2",
		"cross-env": "^10.1.0",
		"css-loader": "^7.1.4",
		"cssnano": "^8.0.2",
		"esbuild": "^0.28.1",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "^17.0.8",
		"nodemon": "^3.1.14",
		"npm-run-all": "^4.1.5",
		"postcss-loader": "^8.2.1",
		"require-from-string": "^2.0.2",
		"rimraf": "^6.1.3",
		"sass": "^1.101.0",
		"sass-loader": "^17.0.0",
		"stylelint": "^17.14.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-scss": "^7.2.0",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2",
		"webpack-hot-middleware": "^2.26.1",
		"webpack-node-externals": "^3.0.0",
		"workbox-precaching": "^7.4.1",
		"workbox-recipes": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1"
	}
}
