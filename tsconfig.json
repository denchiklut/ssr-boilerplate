{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"noImplicitAny": true,
		"allowSyntheticDefaultImports": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitThis": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipDefaultLibCheck": true,
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": true,
		"module": "preserve",
		"target": "esnext",
		"jsx": "react-jsx",
		"lib": ["esnext", "dom", "webworker", "DOM.Iterable"],
		"paths": {
			"@/src/*": ["./src/*"],
			"@/common": ["./src/common/index.ts"],
			"@/common/*": ["./src/common/*"],
			"@/rsc": ["./src/server/utils/rsc/index.ts"],
			"@/server/*": ["./src/server/*"],
			"@/client/*": ["./src/client/*"],
			"@/pages/*": ["./src/client/pages/*"],
			"@/components/*": ["./src/client/components/*"],
			"@/shared/*": ["./src/client/components/@shared/*"],
			"@/api": ["./src/client/api/index.ts"],
			"@/api/*": ["./src/client/api/*"],
			"@/utils": ["./src/client/utils/index.ts"],
			"@/utils/*": ["./src/client/utils/*"],
			"@/config/*": ["./config/*"]
		},
		"typeRoots": ["@types", "node_modules/@types"],
		"types": ["webpack-env"]
	},
	"exclude": ["node_modules"]
}
